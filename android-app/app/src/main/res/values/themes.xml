<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#07060F</color>
    <color name="magenta">#E0359F</color>
    <color name="orange">#FF9A1F</color>
    <color name="green">#3DDC84</color>
    <color name="text">#FFFFFF</color>
    <color name="muted">#B9B4C9</color>
    <color name="card">#16142A</color>

    <style name="Theme.Mizhi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/magenta</item>
    </style>

    <style name="BarTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="BarIcon">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:contentDescription">@null</item>
    </style>
    <style name="BarText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
