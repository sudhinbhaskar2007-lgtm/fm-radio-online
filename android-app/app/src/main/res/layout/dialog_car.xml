<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/car_title"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Switch
        android:id="@+id/autoCar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/auto_car"
        android:textColor="@color/text"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/auto_car_hint"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/pickCar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bottom_bar"
        android:paddingLeft="22dp"
        android:paddingTop="10dp"
        android:paddingRight="22dp"
        android:paddingBottom="10dp"
        android:text="@string/pick_car"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/carName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/orange"
        android:textSize="14sp" />

    <Switch
        android:id="@+id/autoOpen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/auto_open"
        android:textColor="@color/text"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/carDone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:padding="10dp"
        android:text="@string/done"
        android:textColor="@color/magenta"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
