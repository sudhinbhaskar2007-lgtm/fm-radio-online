<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="128dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="24dp"
            android:paddingRight="20dp">

            <!-- Blinking eye logo with pulsing rings -->
            <FrameLayout
                android:id="@+id/eyeBox"
                android:layout_width="310dp"
                android:layout_height="310dp">

                <View
                    android:id="@+id/ring1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/ring" />

                <View
                    android:id="@+id/ring2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/ring2" />

                <FrameLayout
                    android:id="@+id/eyeFrame"
                    android:layout_width="244dp"
                    android:layout_height="244dp"
                    android:layout_gravity="center"
                    android:background="@drawable/eye_frame"
                    android:elevation="12dp"
                    android:padding="4dp">

                    <FrameLayout
                        android:id="@+id/eyeClip"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/oval_dark">

                        <ImageView
                            android:id="@+id/eyeStill"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/app_name"
                            android:scaleType="centerCrop"
                            android:src="@drawable/station_art" />

                        <TextureView
                            android:id="@+id/eyeVideo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </FrameLayout>
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:text="MIZHI FM"
                android:textColor="#FF9A1F"
                android:textSize="46sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/station_ml"
                android:textColor="#FFB25C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/airPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/pill"
                android:letterSpacing="0.18"
                android:paddingLeft="22dp"
                android:paddingTop="9dp"
                android:paddingRight="22dp"
                android:paddingBottom="9dp"
                android:text="● LIVE NOW"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/bars"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/songTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/tap_play"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/songArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/tagline"
                android:textColor="@color/muted"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/orange"
                android:textSize="14sp" />

            <!-- On air / up next card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/onair_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/thumb"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/thumb_round"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/station_art" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/onAirLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.15"
                        android:text="@string/on_air"
                        android:textColor="#FF6A3D"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/upNext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/always_on"
                        android:textColor="@color/muted"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sponsor advert (phone screen only; never shown in the car / Android Auto) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:letterSpacing="0.2"
                android:text="@string/ad_label"
                android:textColor="#99FFFFFF"
                android:textSize="10sp" />

            <FrameLayout
                android:id="@+id/adBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/ad_card"
                android:contentDescription="@string/ad_desc"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/adImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/ad_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ad_shan" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/credit"
                android:textColor="#77FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/contactLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:padding="6dp"
                android:text="@string/contact"
                android:textColor="#B9B4C9"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Mizhi News, shown inside the app (the radio keeps playing) -->
    <FrameLayout
        android:id="@+id/newsBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="92dp"
        android:background="#FFFFFF"
        android:visibility="gone">

        <WebView
            android:id="@+id/newsWeb"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/newsLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:indeterminateTint="#D70B02"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom bar with the big play button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_gravity="bottom"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bottom_bar"
            android:elevation="10dp"
            android:orientation="horizontal">

            <LinearLayout android:id="@+id/tabRadio" style="@style/BarTab">
                <ImageView style="@style/BarIcon" android:src="@drawable/ic_radio" />
                <TextView style="@style/BarText" android:text="@string/tab_radio" />
            </LinearLayout>

            <LinearLayout android:id="@+id/tabNews" style="@style/BarTab">
                <ImageView style="@style/BarIcon" android:src="@drawable/ic_news" />
                <TextView style="@style/BarText" android:text="@string/tab_news" />
            </LinearLayout>

            <View
                android:layout_width="104dp"
                android:layout_height="match_parent" />

            <LinearLayout android:id="@+id/tabCar" style="@style/BarTab">
                <ImageView style="@style/BarIcon" android:src="@drawable/ic_car" />
                <TextView style="@style/BarText" android:text="@string/tab_car" />
            </LinearLayout>

            <LinearLayout android:id="@+id/tabShare" style="@style/BarTab">
                <ImageView style="@style/BarIcon" android:src="@drawable/ic_share" />
                <TextView style="@style/BarText" android:text="@string/tab_share" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/playButton"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal|top"
            android:background="@drawable/play_white"
            android:clickable="true"
            android:contentDescription="@string/play"
            android:elevation="16dp"
            android:focusable="true">

            <ImageView
                android:id="@+id/playIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_play_brand" />

            <ProgressBar
                android:id="@+id/spinner"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:indeterminateTint="#E0359F"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
